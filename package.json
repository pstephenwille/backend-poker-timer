{
  "name": "backend-poker-timer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome ci .",
    "typecheck": "tsc --noEmit && pnpm -r exec tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "sst": "sst"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^24.19.2",
    "sst": "4.17.2",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
